# HealthHub configuration — copy to .env (gitignored) or set in your platform secret store.
# NEVER commit real values. The repo and rendered dashboard must contain no secrets (§A).

# --- Dexcom Share (cloud path; region=ous outside the US) ---
DEXCOM_USERNAME=
DEXCOM_PASSWORD=
DEXCOM_REGION=ous

# --- Nightscout backbone ---
NS_URL=
NS_TOKEN=
# API_SECRET must NOT equal the Dexcom password
NS_API_SECRET=

# --- Google Sheets (Health Connect export + Health Log) ---
# service-account JSON, or a path to the json file
GOOGLE_SA_JSON=
HEALTH_LOG_SHEET_ID=
WEARABLES_SHEET_ID=

# --- Claude (language only; numbers come from Python) ---
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5
MODEL_DEEP=claude-opus-4-8

# --- Telegram logger + alerts ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email alerts (optional) ---
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
